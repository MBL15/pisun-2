# Скопируйте в .env при запуске через Docker Compose (необязательно).
# Без ключей прототип полностью работает: карта — кликом, ИИ — Java-эвристика.

# Яндекс Карты JS API — геокодер «Найти адрес» на форме мероприятия
VITE_YANDEX_MAPS_API_KEY=

# OpenAI-совместимый LLM для ai-moderation-service (YandexGPT, Ollama и т.д.)
AI_LLM_API_KEY=
AI_LLM_BASE_URL=https://api.openai.com/v1
AI_LLM_MODEL=gpt-4o-mini
